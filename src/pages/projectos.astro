---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Projetos — Para Breve | Lavoura Design">
  <main class="relative z-10 min-h-[80vh] flex flex-col justify-center px-8 max-w-5xl mx-auto">
    
    <!-- Cabeçalho / Categoria -->
    <div class="mb-12 fade-up" style="animation-delay: 0.1s;">
      <span class="text-[9px] font-mono tracking-[0.4em] text-neutral-600 uppercase">
        02 projetos
      </span>
    </div>

    <!-- Título Principal -->
    <h1 class="fade-up mb-6" style="animation-delay: 0.2s;">
      <span class="block text-white font-light text-5xl md:text-7xl leading-[1.05] tracking-tight mb-2">
        Para breve.
      </span>
      <span class="block text-neutral-500 font-light text-5xl md:text-7xl leading-[1.05] tracking-tight italic">
        Estamos a preparar novidades
      </span>
    </h1>

    <!-- Descrição -->
    <p class="text-neutral-400 font-light text-sm md:text-base max-w-lg mb-12 fade-up" style="animation-delay: 0.3s;">
      O portefólio está a ser atualizado com novos trabalhos de identidade visual e ecossistemas digitais. Fica atento.
    </p>

    <!-- Link para voltar -->
    <div class="fade-up" style="animation-delay: 0.4s;">
      <a href="/" class="inline-flex items-center gap-3 group text-[10px] font-mono uppercase tracking-[0.4em] text-white">
        <span class="w-8 h-[1px] bg-white group-hover:w-12 transition-all duration-300"></span>
        Voltar ao início
      </a>
    </div>

  </main>
</Layout>