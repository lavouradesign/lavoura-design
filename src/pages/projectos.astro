
---
// src/pages/projetos.astro
import Layout from '../layouts/Layout.astro';
 
// Quando tiveres projetos reais, substitui este array
const projetos = [
    {
        numero: '01',
        titulo: 'Nome do Projeto',
        tipo: 'Identidade Visual',
        ano: '2026',
        cor: '#0f0f0f',
    },
    {
        numero: '02',
        titulo: 'Nome do Projeto',
        tipo: 'Web Design',
        ano: '2026',
        cor: '#0a0a0a',
    },
    {
        numero: '03',
        titulo: 'Nome do Projeto',
        tipo: 'Design para Impressão',
        ano: '2025',
        cor: '#0f0f0f',
    },
    {
        numero: '04',
        titulo: 'Nome do Projeto',
        tipo: 'Redes Sociais',
        ano: '2025',
        cor: '#0a0a0a',
    },
];
---
<Layout title="Projetos — lavoura design">
 
    <div class="max-w-5xl mx-auto px-8 py-20">
 
        <!-- Header -->
        <div class="flex items-end justify-between mb-20 pb-8 border-b border-neutral-900 fade-up">
            <h1 class="text-[9px] font-mono tracking-[0.4em] text-neutral-600 uppercase">Projetos Selecionados</h1>
            <span class="text-[9px] font-mono text-neutral-800">{projetos.length} trabalhos</span>
        </div>
 
        <!-- Grelha de projetos -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-neutral-900 mb-24">
            {projetos.map((projeto, i) => (
                <div 
                    class="project-card group relative bg-[#050505] hover:bg-neutral-950 transition-all duration-500 cursor-pointer fade-up"
                    style={`animation-delay: ${0.1 + i * 0.08}s`}
                >
                    <!-- Thumbnail -->
                    <div class="aspect-[16/10] relative overflow-hidden" style={`background: ${projeto.cor}`}>
                        <!-- Placeholder — substitui por <img> quando tiveres imagens -->
                        <div class="absolute inset-0 flex items-center justify-center">
                            <span class="text-[10px] font-mono text-neutral-800 tracking-widest opacity-0 group-hover:opacity-100 transition-opacity duration-500">
                                Em breve
                            </span>
                        </div>
                        <!-- Linha decorativa animada no hover -->
                        <div class="absolute bottom-0 left-0 w-0 h-[1px] bg-neutral-700 group-hover:w-full transition-all duration-700"></div>
                    </div>
 
                    <!-- Info -->
                    <div class="p-6 flex justify-between items-end">
                        <div>
                            <p class="text-[8px] font-mono text-neutral-700 mb-2">{projeto.numero}</p>
                            <h3 class="text-white text-[11px] font-light tracking-wide group-hover:text-neutral-200 transition-colors duration-300">
                                {projeto.titulo}
                            </h3>
                            <p class="text-[9px] font-mono text-neutral-600 mt-1">{projeto.tipo}</p>
                        </div>
                        <div class="flex flex-col items-end gap-2">
                            <span class="text-[8px] font-mono text-neutral-800">{projeto.ano}</span>
                            <span class="text-[10px] text-neutral-700 group-hover:text-neutral-400 group-hover:translate-x-1 transition-all duration-300">→</span>
                        </div>
                    </div>
                </div>
            ))}
        </div>
 
        <!-- Nota e CTA -->
        <div class="border-t border-neutral-900 pt-16 flex flex-col md:flex-row md:justify-between md:items-end gap-8 fade-up">
            <div>
                <p class="text-[9px] font-mono tracking-[0.4em] text-neutral-800 uppercase mb-3">Portfólio em crescimento</p>
                <p class="text-[11px] text-neutral-600 font-light leading-relaxed max-w-xs">
                    Mais projetos a chegar. Entretanto, fala comigo sobre o teu.
                </p>
            </div>
            <a href="/contacto" class="group flex items-center gap-4 text-[10px] font-mono tracking-[0.25em] uppercase text-white border border-neutral-800 px-6 py-4 hover:border-neutral-600 hover:bg-neutral-900 transition-all duration-300 self-start md:self-auto">
                Iniciar projeto
                <span class="group-hover:translate-x-1 transition-transform duration-300">→</span>
            </a>
        </div>
 
    </div>
 
</Layout>
 
<style>
    .fade-up {
        opacity: 0;
        transform: translateY(14px);
        animation: fadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    @keyframes fadeUp {
        to { opacity: 1; transform: translateY(0); }
    }
    @media (prefers-reduced-motion: reduce) {
        .fade-up { animation: none; opacity: 1; transform: none; }
    }
</style>
 