---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/site';

const featured = projects.slice(0, 3);
const btnPrimary = 'inline-block bg-white text-black px-6 py-3 text-[11px] font-mono tracking-[0.2em] uppercase hover:bg-neutral-300 transition-colors duration-300';
const btnGhost = 'inline-block border border-neutral-700 text-neutral-300 px-6 py-3 text-[11px] font-mono tracking-[0.2em] uppercase hover:border-white hover:text-white transition-colors duration-300';

// Linhas onduladas, como regos numa lavoura.
const rows = Array.from({ length: 16 }, (_, i) => {
    const y = 40 + i * 30;
    return `M0 ${y} C 160 ${y - 34}, 320 ${y + 34}, 480 ${y} S 760 ${y - 30}, 800 ${y - 8}`;
});
---
<Layout title="Lavoura Design — designer gráfico e web">
    <section class="relative overflow-hidden px-8 py-28 sm:py-40">
        <svg class="absolute right-0 top-0 h-full w-[75%] text-white opacity-[0.07] pointer-events-none" viewBox="0 0 800 560" preserveAspectRatio="xMaxYMid slice" aria-hidden="true">
            {rows.map((d) => <path d={d} fill="none" stroke="currentColor" stroke-width="1.5" />)}
        </svg>
        <div class="relative max-w-6xl mx-auto">
            <div class="max-w-2xl space-y-8">
                <h1 class="text-4xl sm:text-6xl font-light text-white tracking-tight leading-[1.05]">
                    Marcas e sites que se percebem à primeira.
                </h1>
                <p class="text-lg text-neutral-400 font-light leading-relaxed max-w-xl">
                    Sou o Guilherme, designer gráfico e web em Figueira da Foz. Desenho identidades visuais,
                    interfaces e websites, e também os construo.
                </p>
                <div class="flex flex-wrap gap-4">
                    <a href="/projectos" class={btnPrimary}>Ver projetos</a>
                    <a href="/contacto" class={btnGhost}>Falar comigo</a>
                </div>
            </div>
        </div>
    </section>

    <section class="px-8 py-20 border-t border-neutral-900">
        <div class="max-w-6xl mx-auto grid gap-10 md:grid-cols-[1fr_2fr]">
            <h2 class="text-2xl font-light text-white">O que faço</h2>
            <ul>
                <li class="py-6 border-t border-neutral-900">
                    <h3 class="text-white font-normal mb-2">Identidade visual</h3>
                    <p class="text-neutral-500 max-w-prose">Logótipo, cores, tipografia e regras de uso, para a tua marca ter a mesma cara em todo o lado.</p>
                </li>
                <li class="py-6 border-t border-neutral-900">
                    <h3 class="text-white font-normal mb-2">Web design e desenvolvimento</h3>
                    <p class="text-neutral-500 max-w-prose">Do desenho em Figma ao site online, em código ou em ferramentas no-code como Webflow e Framer.</p>
                </li>
                <li class="py-6 border-y border-neutral-900">
                    <h3 class="text-white font-normal mb-2">Conteúdo para redes sociais</h3>
                    <p class="text-neutral-500 max-w-prose">Publicações e sistemas visuais que mantêm a página reconhecível e fáceis de repetir.</p>
                </li>
            </ul>
        </div>
    </section>

    <section class="px-8 py-20 border-t border-neutral-900">
        <div class="max-w-6xl mx-auto space-y-10">
            <h2 class="text-2xl font-light text-white">Projetos em destaque</h2>
            <div class="grid gap-10 md:grid-cols-3">
                {featured.map((p) => (
                    <article class="flex flex-col gap-4">
                        <div class="flex h-28 border border-neutral-900 overflow-hidden" aria-hidden="true">
                            {p.image
                                ? <img src={p.image} alt="" loading="lazy" class="w-full h-full object-cover" />
                                : p.colors.map((c, i) => <span class={i === 0 ? 'flex-[3]' : 'flex-1'} style={`background:${c}`} />)}
                        </div>
                        <span class="self-start text-[9px] font-mono tracking-[0.2em] uppercase text-neutral-500 border border-neutral-800 px-3 py-1">{p.status}</span>
                        <h3 class="text-white font-normal text-lg">{p.title}</h3>
                        <p class="text-neutral-500 text-sm leading-relaxed">{p.summary}</p>
                        <a href={`/projectos#${p.id}`} class="mt-auto text-[10px] font-mono tracking-[0.2em] uppercase text-neutral-300 hover:text-white transition-colors duration-300">Ler o projeto ↗</a>
                    </article>
                ))}
            </div>
            <a href="/projectos" class={btnGhost}>Ver todos os projetos</a>
        </div>
    </section>

    <section class="px-8 py-20 border-t border-neutral-900">
        <div class="max-w-6xl mx-auto grid gap-10 md:grid-cols-[1fr_2fr]">
            <h2 class="text-2xl font-light text-white">Tens um projeto em mente?</h2>
            <div class="space-y-6">
                <p class="text-neutral-400">Conta-me o que precisas e respondo por email.</p>
                <a href="/contacto" class={btnPrimary}>Enviar mensagem</a>
            </div>
        </div>
    </section>
</Layout>
