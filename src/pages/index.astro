---
---

<html lang="pt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lavoura Design - Em Construção</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html, body {
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        background-color: #050505;
      }
      .maintenance-container {
        width: 100vw;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #050505;
      }
      .maintenance-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        user-select: none;
        pointer-events: none;
      }
    </style>
  </head>
  <body>
    <div class="maintenance-container">
      <img src="/web.png" alt="Lavoura Design - Em Construção" />
    </div>
  </body>
</html>