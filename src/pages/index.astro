---
import Layout from '../layouts/Layout.astro';
---

<Layout title="lavoura design — Guilherme Ribeiro">

    <!-- CONTEÚDO PRINCIPAL (HERO / FRASE DE ENTRADA) -->
    <section class="relative z-10 min-h-screen flex flex-col justify-center px-8 max-w-6xl mx-auto pt-20">
        <div class="mb-8">
            <span class="text-[9px] font-mono tracking-[0.4em] text-neutral-500 uppercase">
                Web Design & UI/UX · Portugal
            </span>
        </div>

        <h1 class="text-white font-light text-5xl md:text-7xl leading-[1.05] tracking-tight mb-8 max-w-4xl">
            Desenho interfaces que os utilizadores adoram e os negócios convertem.
        </h1>

        <p class="text-[13px] text-neutral-400 font-light leading-relaxed max-w-xl mb-12">
            Foco em experiências limpas, editoriais e orientadas a resultados. Trabalho com precisão técnica do vetor ao código.
        </p>

        <div class="flex items-center gap-6">
            <a href="/projetos" class="group flex items-center gap-3 text-[10px] font-mono tracking-[0.25em] uppercase text-white bg-white/10 px-6 py-4 hover:bg-white/20 transition-all">
                Explorar projetos
                <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>
            <a href="/sobre" class="text-[10px] font-mono tracking-[0.25em] uppercase text-neutral-400 hover:text-white px-6 py-4 transition-colors">
                Conhecer percurso
            </a>
        </div>
    </section>

</Layout>