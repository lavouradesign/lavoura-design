---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';

const field = 'w-full bg-transparent border border-neutral-800 px-4 py-3 text-neutral-200 placeholder:text-neutral-700 focus:border-neutral-400 outline-none transition-colors duration-300';
const label = 'block space-y-2 text-[10px] font-mono tracking-[0.2em] uppercase text-neutral-500';
---
<Layout title="Contacto — Lavoura Design" description="Fala com o Guilherme Lavoura sobre o teu projeto de design ou website.">
    <section class="px-8 py-20 sm:py-28">
        <div class="max-w-6xl mx-auto grid gap-12 md:grid-cols-[1fr_1.4fr]">
            <div class="space-y-6">
                <h1 class="text-4xl sm:text-5xl font-light text-white tracking-tight">Contacto</h1>
                <p class="text-neutral-400 leading-relaxed">Conta-me o que precisas. Respondo por email.</p>
                <p class="text-sm text-neutral-500">
                    Preferes escrever diretamente?<br />
                    <a href={`mailto:${site.email}`} class="text-neutral-200 hover:text-white underline underline-offset-4 decoration-neutral-700">{site.email}</a>
                </p>
            </div>

            <form id="contact-form" novalidate class="space-y-6 max-w-xl">
                <label class={label}>
                    <span>Nome</span>
                    <input name="name" type="text" autocomplete="name" required maxlength="100" class={`${field} normal-case tracking-normal font-sans text-base`} />
                </label>
                <label class={label}>
                    <span>Email</span>
                    <input name="email" type="email" autocomplete="email" required maxlength="150" class={`${field} normal-case tracking-normal font-sans text-base`} />
                </label>
                <label class={label}>
                    <span>Mensagem</span>
                    <textarea name="message" required maxlength="3000" rows="6" class={`${field} min-h-40 resize-y normal-case tracking-normal font-sans text-base`}></textarea>
                </label>

                <input name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" class="absolute -left-[9999px]" />

                <p class="text-xs text-neutral-600 leading-relaxed">
                    Ao enviar, aceitas que uso os teus dados só para te responder. Vê a
                    <a href="/privacidade" class="underline underline-offset-4 decoration-neutral-700 hover:text-neutral-300">política de privacidade</a>.
                </p>

                <button id="send" type="submit"
                    class="bg-white text-black px-6 py-3 text-[11px] font-mono tracking-[0.2em] uppercase hover:bg-neutral-300 disabled:opacity-50 disabled:cursor-wait transition-colors duration-300 cursor-pointer">
                    Enviar mensagem
                </button>
                <p id="form-status" role="status" aria-live="polite" class="min-h-6 text-sm"></p>
            </form>
        </div>
    </section>
</Layout>

<script define:vars={{ email: site.email }}>
    const form = document.getElementById('contact-form');
    const status = document.getElementById('form-status');
    const btn = document.getElementById('send');
    const base = 'min-h-6 text-sm ';
    const OK = base + 'text-neutral-200';
    const ERR = base + 'text-red-400';

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        status.className = base + 'text-neutral-500';
        const data = Object.fromEntries(new FormData(form));

        if (!data.name.trim() || !/^\S+@\S+\.\S+$/.test(data.email) || data.message.trim().length < 10) {
            status.className = ERR;
            status.textContent = 'Preenche o nome, um email válido e uma mensagem com pelo menos 10 caracteres.';
            return;
        }

        btn.disabled = true;
        status.textContent = 'A enviar…';
        try {
            const res = await fetch('/api/contact', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data),
            });
            if (!res.ok) throw new Error();
            form.reset();
            status.className = OK;
            status.textContent = 'Mensagem enviada. Respondo em breve.';
        } catch {
            status.className = ERR;
            status.textContent = `Não foi possível enviar. Tenta novamente ou escreve para ${email}.`;
        } finally {
            btn.disabled = false;
        }
    });
</script>
