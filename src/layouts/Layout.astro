
---
// src/layouts/Layout.astro
interface Props {
	title: string;
}
const { title } = Astro.props;
const currentPath = Astro.url.pathname;
---
<html lang="pt">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/png" href="/Arte2_3727834b-75d8-419d-917b-1f00881b04bc.png" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;1,300&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet">
    </head>
    
    <body class="bg-[#050505] text-neutral-400 antialiased min-h-screen flex flex-col relative">
 
        <!-- Fade-in overlay para transições entre páginas -->
        <div id="page-transition" class="fixed inset-0 bg-[#050505] z-50 pointer-events-none opacity-0 transition-opacity duration-500"></div>
        
        <header class="w-full px-8 py-7 flex justify-between items-center z-20 border-b border-neutral-900">
            <a href="/" class="group flex items-center gap-3">
                <img 
                    src="/Arte2_3727834b-75d8-419d-917b-1f00881b04bc.png" 
                    alt="Lavoura Design" 
                    class="h-5 w-auto opacity-70 group-hover:opacity-100 transition-opacity duration-300"
                />
                <span class="text-[10px] font-mono tracking-[0.25em] text-neutral-500 uppercase group-hover:text-neutral-300 transition-colors duration-300">
                    lavoura
                </span>
            </a>
            <nav class="flex items-center gap-8">
                <a href="/projectos" class={`nav-link text-[10px] font-mono tracking-[0.2em] uppercase transition-colors duration-300 ${currentPath.startsWith('/projectos') ? 'text-white' : 'text-neutral-600 hover:text-neutral-300'}`}>
                    Projetos
                </a>
                <a href="/sobre" class={`nav-link text-[10px] font-mono tracking-[0.2em] uppercase transition-colors duration-300 ${currentPath === '/sobre' ? 'text-white' : 'text-neutral-600 hover:text-neutral-300'}`}>
                    Sobre
                </a>
                <a href="/contacto" class={`nav-link text-[10px] font-mono tracking-[0.2em] uppercase transition-colors duration-300 ${currentPath === '/contacto' ? 'text-white' : 'text-neutral-600 hover:text-neutral-300'}`}>
                    Contacto
                </a>
            </nav>
        </header>
 
        <main class="w-full flex-grow z-10">
            <slot /> 
        </main>
 
        <footer class="w-full px-8 py-7 flex justify-between items-center border-t border-neutral-900 z-10">
            <span class="text-[9px] font-mono tracking-widest text-neutral-800 uppercase">
                © {new Date().getFullYear()} Lavoura Design
            </span>
            <a href="mailto:guilavourar@gmail.com" class="text-[9px] font-mono tracking-widest text-neutral-700 hover:text-neutral-400 transition-colors duration-300">
                guilavourar@gmail.com ↗
            </a>
        </footer>
 
        <script is:inline>
            // Transição suave de entrada em todas as páginas
            document.addEventListener('DOMContentLoaded', () => {
                const overlay = document.getElementById('page-transition');
                if (overlay) {
                    overlay.style.opacity = '1';
                    requestAnimationFrame(() => {
                        setTimeout(() => {
                            overlay.style.opacity = '0';
                        }, 50);
                    });
                }
 
                // Transição suave de saída ao clicar em links internos
                document.querySelectorAll('a[href^="/"]').forEach(link => {
                    link.addEventListener('click', (e) => {
                        const href = link.getAttribute('href');
                        if (href && !href.startsWith('//') && !link.target) {
                            e.preventDefault();
                            if (overlay) overlay.style.opacity = '1';
                            setTimeout(() => { window.location.href = href; }, 450);
                        }
                    });
                });
            });
        </script>
    </body>
</html>
 
<style is:global>
    @import "tailwindcss";
 
    html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
    }
 
    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
    }
 
    .font-mono {
        font-family: 'DM Mono', monospace;
    }
 
    ::selection {
        background: rgba(255,255,255,0.1);
        color: white;
    }
 
    * {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }
</style>
 