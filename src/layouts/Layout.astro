---
interface Props {
	title?: string;
}

const { title = "Lavoura Design" } = Astro.props;
---

<!DOCTYPE html>
<html lang="pt">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body class="bg-[#050505] margin-0 padding-0 overflow-hidden">
		<slot />
	</body>
</html>