---
// src/layouts/Layout.astro
import CookieNotice from '../components/CookieNotice.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
    title: string;
    description?: string;
}
const {
    title,
    description = 'Guilherme Lavoura, designer gráfico e web em Figueira da Foz. Identidade visual, UI/UX e websites.',
} = Astro.props;
---
<html lang="pt">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/png" href="/Arte2_3727834b-75d8-419d-917b-1f00881b04bc.png" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;1,300&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet">
    </head>

    <body class="bg-[#050505] text-neutral-400 antialiased min-h-screen flex flex-col relative selection:bg-neutral-800 selection:text-white">

        <!-- Fade-in overlay para transições entre páginas -->
        <div id="page-transition" class="fixed inset-0 bg-[#050505] z-50 pointer-events-none opacity-0 transition-opacity duration-500"></div>

        <a href="#main" class="absolute -top-20 left-4 z-[60] bg-white text-black px-4 py-2 text-xs font-mono focus:top-4">Saltar para o conteúdo</a>

        <Nav />

        <main id="main" class="w-full flex-grow z-10">
            <slot />
        </main>

        <Footer />

        <!-- Componente de Cookies Criativo integrado -->
        <CookieNotice />

        <script is:inline>
            document.addEventListener('DOMContentLoaded', () => {
                const overlay = document.getElementById('page-transition');
                if (overlay) {
                    overlay.style.opacity = '1';
                    requestAnimationFrame(() => {
                        setTimeout(() => { overlay.style.opacity = '0'; }, 50);
                    });
                }

                // Transição de saída em links internos.
                // Ignora downloads, PDFs, âncoras na mesma página e cliques com Ctrl/Cmd/Shift.
                document.querySelectorAll('a[href^="/"]').forEach(link => {
                    link.addEventListener('click', (e) => {
                        const href = link.getAttribute('href');
                        if (!href || href.startsWith('//') || link.target) return;
                        if (link.hasAttribute('download') || href.toLowerCase().endsWith('.pdf')) return;
                        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
                        const url = new URL(link.href, location.origin);
                        if (url.pathname === location.pathname && url.hash) return;
                        e.preventDefault();
                        if (overlay) overlay.style.opacity = '1';
                        setTimeout(() => { window.location.href = href; }, 450);
                    });
                });
            });

            // Ao voltar atrás, o browser pode repor a página com o overlay visível.
            window.addEventListener('pageshow', (e) => {
                if (e.persisted) {
                    const overlay = document.getElementById('page-transition');
                    if (overlay) overlay.style.opacity = '0';
                }
            });
        </script>
    </body>
</html>

<style is:global>
    @import "tailwindcss";

    html {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        scroll-behavior: smooth;
        scroll-padding-top: 6rem;
    }

    /* Sem height:100% no body, para o header sticky acompanhar a página toda */
    body {
        margin: 0;
        padding: 0;
        width: 100%;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .font-mono {
        font-family: 'DM Mono', monospace;
    }

    ::selection {
        background: rgba(255,255,255,0.1);
        color: white;
    }

    * {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    :focus-visible {
        outline: 1px solid #fff;
        outline-offset: 4px;
    }

    /* Menu em ecrãs pequenos */
    @media (max-width: 639px) {
        #nav-links {
            display: none;
            position: absolute;
            left: 0;
            right: 0;
            top: 100%;
            flex-direction: column;
            align-items: flex-start;
            gap: 1.5rem;
            padding: 1.5rem 2rem;
            background: #050505;
            border-bottom: 1px solid #171717;
        }
        #nav-links.open { display: flex; }
    }

    @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
    }
</style>
